{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-native",
    "lib": ["ES2020"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "esModuleInterop": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["example", "lib", "node_modules"]
}
